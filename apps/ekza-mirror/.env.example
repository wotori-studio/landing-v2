# Used server-side by the existing privacy-friendly analytics tracker and beta API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BETA_SIGNUP_CONSENT_VERSION=mirror-beta-v1

# Optional: set this only if referral codes must survive service-role key rotation.
# When omitted, the API derives a domain-separated HMAC key from the service role.
# BETA_SIGNUP_REFERRAL_SECRET=replace-with-at-least-32-random-bytes

# Canonical origin used in referral links. Preview deployments may omit this to
# use the current request origin instead.
MIRROR_PUBLIC_URL=https://mirror.ekza.io
